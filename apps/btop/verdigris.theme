# Verdigris theme for btop
# Inspired by oxidized copper: weathered bronze, warm vellum,
# patina/fern greens, oxidized aqua, restrained brass ochre, and moss.

# Main background, empty for terminal default / transparency
# theme[main_bg]=""
theme[main_bg]="#1d2021"

# Main text color
theme[main_fg]="#ebdbb2"

# Title color for boxes
theme[title]="#ebdbb2"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#8ec07c"

# Background color of selected items
theme[selected_bg]="#665c54"

# Foreground color of selected items
theme[selected_fg]="#fbf1c7"

# Color of inactive/disabled text
theme[inactive_fg]="#3c3836"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#d4be9a"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#83a598"

# Box outline colors
theme[cpu_box]="#665c54"
theme[mem_box]="#665c54"
theme[net_box]="#665c54"
theme[proc_box]="#665c54"

# Box divider line and small boxes line color
theme[div_line]="#3c3836"

# Temperature graph colors
theme[temp_start]="#83a598"
theme[temp_mid]="#e6bf86"
theme[temp_end]="#fb4934"

# CPU graph colors
theme[cpu_start]="#689d6a"
theme[cpu_mid]="#e6bf86"
theme[cpu_end]="#fb4934"

# Mem/Disk free meter
theme[free_start]="#70764a"
theme[free_mid]=""
theme[free_end]="#8ec07c"

# Mem/Disk cached meter
theme[cached_start]="#458588"
theme[cached_mid]=""
theme[cached_end]="#83a598"

# Mem/Disk available meter
theme[available_start]="#604b29"
theme[available_mid]=""
theme[available_end]="#e6bf86"

# Mem/Disk used meter
theme[used_start]="#604b29"
theme[used_mid]="#8b6021"
theme[used_end]="#cc241d"

# Download graph colors
theme[download_start]="#3c3836"
theme[download_mid]="#689d6a"
theme[download_end]="#83a598"

# Upload graph colors
theme[upload_start]="#604b29"
theme[upload_mid]="#e6bf86"
theme[upload_end]="#d3869b"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#689d6a"
theme[process_mid]="#e6bf86"
theme[process_end]="#fb4934"
