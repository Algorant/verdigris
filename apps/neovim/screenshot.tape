# neovim - verdigris screen. Regenerate with: vhs screenshot.tape
Output "/tmp/verdigris-shot/rec.gif"
Set Width 1600
Set Height 1000
Set Padding 0
Set Margin 0
Set FontFamily "JetBrainsMono Nerd Font"
Set FontSize 22
Set LineHeight 1.2
Set LetterSpacing 1
Set TypingSpeed 0s
Set Shell "bash"
Set Theme {
  "background": "#1d2021",
  "foreground": "#ebdbb2",
  "cursor": "#ebdbb2",
  "selection": "#665c54",
  "black": "#1d2021",
  "red": "#c66f70",
  "green": "#689d6a",
  "yellow": "#e6bf86",
  "blue": "#458588",
  "magenta": "#8989b0",
  "cyan": "#83a598",
  "white": "#d4be9a",
  "brightBlack": "#928374",
  "brightRed": "#d47b7c",
  "brightGreen": "#8ec07c",
  "brightYellow": "#e6bf86",
  "brightBlue": "#83a598",
  "brightMagenta": "#8989b0",
  "brightCyan": "#83a598",
  "brightWhite": "#ebdbb2"
}
Type "export PS1=demo@workstation:\~/project\$\  HOME=/tmp/verdigris-shot/home ATUIN_SESSION=verdigris-fixture LANG=C.UTF-8 LC_ALL=C.UTF-8"
Enter
Type "clear"
Enter
Type "cd /tmp/verdigris-shot/project"
Enter
Sleep 1s
Type "./shot"
Enter
Sleep 3s
Screenshot "/home/algorant/.local/state/algomarchy/verdigris-shots/neovim/screenshot.png"
