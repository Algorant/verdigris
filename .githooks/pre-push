#!/usr/bin/env bash
set -euo pipefail

root=$(git rev-parse --show-toplevel)
private_config="$HOME/.config/privacy-check/literals.gitleaks.toml"
if [[ ! -r "$private_config" ]]; then
  printf 'Missing required local privacy policy: %s\n' "$private_config" >&2
  exit 1
fi
# Both guards read the same pre-push ref lines, so read them once.
input=$(cat)

while read -r local_ref local_oid remote_ref remote_oid; do
  # An empty line (nothing to push) and a deleted ref introduce no commits.
  [[ -n "$local_ref$local_oid$remote_ref$remote_oid" ]] || continue
  [[ "$local_oid" =~ ^0+$ ]] && continue

  if [[ "$remote_oid" =~ ^0+$ ]]; then
    range="$local_oid"
  else
    range="$remote_oid..$local_oid"
  fi

  printf 'Checking %s -> %s\n' "$local_ref" "$remote_ref" >&2
  for config in "$root/.gitleaks.toml" "$private_config"; do
    mise exec gitleaks@latest -- gitleaks git \
      --no-banner --redact --config "$config" --log-opts="$range" "$root"
    git log --name-only --format='%an <%ae>%n%cn <%ce>%n%B' "$range" |
      mise exec gitleaks@latest -- gitleaks stdin \
        --no-banner --redact --config "$config"
  done
done <<<"$input"

# gitguard owns credentials and personal records; its exit status stops the push.
printf '%s\n' "$input" | gitguard hook pre-push
